{
  "name": "alzs-well-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "catalog:generate": "node scripts/generate-api-catalog.mjs",
    "catalog:check": "node scripts/generate-api-catalog.mjs --check",
    "test": "npm run catalog:check && npm run build && node --test tests/rendered-html.test.mjs && tsx --test tests/api-client.test.ts tests/api-proxy.test.ts tests/api-operation-catalog.test.ts tests/demo-capability-cookie.test.ts tests/demo-rehearsal.test.ts tests/demo-session.test.ts tests/demo-workflow.test.ts tests/staff-case-workflow.test.ts tests/ai-financial-assistance.test.ts tests/extended-api-workflows.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
