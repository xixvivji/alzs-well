# 로컬에서 브라우저가 Spring Boot를 직접 호출할 때만 사용합니다.
# Vercel Preview·Production에서는 비워 두고 같은 origin의 /api BFF를 사용합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Open Graph 절대 URL에 사용하는 공개 프론트 주소입니다.
NEXT_PUBLIC_SITE_URL=https://alzs-well.example.com

# Vercel 서버 라우트가 중계할 AWS HTTPS origin입니다. 경로나 query를 포함하지 않습니다.
BACKEND_API_ORIGIN=https://api.alzs-well.example.com

# Vercel과 AWS Nginx에 동일하게 저장하는 32-byte lowercase hex 비밀값입니다.
# `openssl rand -hex 32`로 생성하며 NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
BACKEND_PROXY_SHARED_SECRET=replace-with-64-lowercase-hex

# AWS Spring의 합성 데모 직원 bootstrap Bearer 토큰입니다. 브라우저에 노출하지 않습니다.
# 이 예시값은 의도적으로 유효하지 않으며 배포 전 64자 이상의 무작위 비밀값으로 교체합니다.
DEMO_STAFF_BOOTSTRAP_TOKEN=change-me

# 공모전 공개 시연에서 유효한 고객 데모 capability를 가진 세션만 행원 화면으로 연결합니다.
DEMO_PUBLIC_STAFF_MODE=true

# 공개 Vercel production에서는 false로 유지합니다. true는 기업 IdP·MFA가 연결된 사설 staging 전용입니다.
NEXT_PUBLIC_PRIVATE_POC_ENABLED=false
# 화면 렌더링에 필요한 서버 전용 2차 gate입니다. 공개 Preview·Production에서는 false로 유지합니다.
PRIVATE_POC_DEPLOYMENT_ALLOWED=false

# DEMO_PUBLIC_STAFF_MODE=false인 운영 직원 경로는 신뢰 프록시가 전달한 RS256 JWT를 서버에서 검증합니다.
# JWT에는 iss, aud, sub, exp와 PROTECTION_STAFF 역할이 필요합니다. 원문 사용자 ID 헤더는 신뢰하지 않습니다.
STAFF_IDENTITY_JWT_PUBLIC_KEY_PEM=replace-with-rs256-spki-public-key
STAFF_IDENTITY_JWT_ISSUER=https://identity.example.com/
STAFF_IDENTITY_JWT_AUDIENCE=alzs-well-staff
STAFF_IDENTITY_REQUIRED_ROLE=PROTECTION_STAFF
# 추가 subject 제한이 필요할 때만 쉼표로 구분합니다. JWT 검증을 대체하지 않습니다.
STAFF_ALLOWED_USER_IDS=
