# 브라우저가 로컬 Spring Boot를 직접 호출할 때만 사용합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Worker가 같은 origin의 /api 요청을 전달할 서버 origin입니다.
# 로컬 HTTP에서는 양쪽 모두 loopback이어야 하고, 배포 환경에서는 HTTPS만 허용합니다.
BACKEND_API_ORIGIN=http://localhost:8080

# 로컬 Miniflare Worker와 Nginx gateway에 동일하게 주입하는 32-byte hex 값입니다.
# 배포에서는 .env/build var가 아니라 플랫폼 runtime secret store를 사용합니다.
# `openssl rand -hex 32`로 생성하고 NEXT_PUBLIC_ 접두사를 사용하지 않습니다.
BACKEND_PROXY_SHARED_SECRET=replace-with-64-lowercase-hex
