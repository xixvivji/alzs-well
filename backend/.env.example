POSTGRES_DB=alzs_well
POSTGRES_USER=alzswell_admin
# 공개 배포 전 반드시 충분히 긴 임의값으로 교체한다. compose는 미설정 시 기동을 거부한다.
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_MIGRATION_PASSWORD=replace-with-a-long-random-migration-password
POSTGRES_APP_PASSWORD=replace-with-a-long-random-runtime-password

# 배포에서는 검증한 immutable digest(`image@sha256:...`)를 지정한다.
NGINX_IMAGE=nginx:1.30.4-alpine
POSTGRES_IMAGE=postgres:17.11-alpine
GATEWAY_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY_CIDR=127.0.0.1/32
SPRING_PROFILES_ACTIVE=production
CORS_CUSTOMER_ALLOWED_ORIGINS=https://customer-demo.example.com
CORS_STAFF_ALLOWED_ORIGINS=https://staff-demo.example.com
DEMO_STAFF_USERNAME=demo-staff
DEMO_STAFF_PASSWORD=replace-with-a-random-staff-password-at-least-32-characters

DB_URL=jdbc:postgresql://localhost:5432/alzs_well
DB_USERNAME=alzswell_app
DB_PASSWORD=replace-with-a-long-random-runtime-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

SERVER_PORT=8080
SYNTHETIC_DATA_ONLY=true
EXTERNAL_ACTIONS_ENABLED=false
NETWORK_MODE=AIR_GAPPED_DEMO
EXTERNAL_EGRESS_ENABLED=false
REMOTE_MODEL_ENABLED=false
SYNTHETIC_PROVIDER_ONLY=true
DEMO_SESSION_TTL_SECONDS=7200
DEMO_MAX_ACTIVE_SESSIONS=1000
DEMO_DEFAULT_LOCALE=ko-KR
DEMO_CLEANUP_INTERVAL_MS=300000
DEMO_CLEANUP_BATCH_SIZE=100
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=28800
AUTH_ABSOLUTE_TTL_SECONDS=86400
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_LOGIN_FAILURE_LIMIT=10
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=900
AUTH_CLEANUP_INTERVAL_MS=3600000
AUTH_CLEANUP_RETENTION_SECONDS=86400
AUTH_LOGIN_EVENT_RETENTION_SECONDS=2592000
AUTH_CLEANUP_BATCH_SIZE=200
