map_hash_bucket_size 128;

# Sites Worker는 실제 IP를 전달하지 않고 HMAC 익명 키만 전달한다. 공유 비밀이
# 정확히 일치할 때에만 해당 키를 신뢰하며, 직접 요청은 연결 원본 IP로 제한한다.
map $http_x_alzs_proxy_secret $trusted_frontend_proxy {
    default 0;
    "${FRONTEND_PROXY_SHARED_SECRET}" 1;
}

map "$http_x_alzs_proxy_secret:$http_x_alzs_client_key" $frontend_proxy_headers_present {
    default 1;
    ":" 0;
}

map "$frontend_proxy_headers_present:$trusted_frontend_proxy:$http_x_alzs_client_key" $reject_untrusted_frontend_proxy {
    default 1;
    "0:0:" 0;
    "~^1:1:[a-f0-9]{64}$" 0;
}

map "$trusted_frontend_proxy:$http_x_alzs_client_key" $request_client_key {
    default $binary_remote_addr;
    "~^1:([a-f0-9]{64})$" $1;
}

map $request_method $mutation_limit_key {
    default $request_client_key;
    GET "";
    HEAD "";
    OPTIONS "";
}

map $request_method $mutation_capability_key {
    default $http_x_demo_capability;
    GET "";
    HEAD "";
    OPTIONS "";
}

map $status $retry_after_seconds {
    default "";
    429 60;
}

geo $realip_remote_addr $trusted_proxy_connection {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}

map "$trusted_proxy_connection:$http_x_forwarded_proto" $trusted_forwarded_proto {
    default $scheme;
    ~*^1:https$ https;
    ~*^1:http$ http;
}

map "$trusted_proxy_connection:$http_x_forwarded_port" $trusted_forwarded_port {
    default $server_port;
    "~^1:[0-9]{1,5}$" $http_x_forwarded_port;
}

set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# 한 화면이 여러 도메인 API를 조합하는 운영형 합성 포털이므로 읽기 요청은
# 5r/s까지 허용한다. mutation·세션 생성 한도는 별도로 낮게 유지한다.
limit_req_zone $request_client_key zone=demo_read:10m rate=300r/m;
limit_req_zone $request_client_key zone=demo_session_create:10m rate=10r/m;
limit_req_zone $mutation_limit_key zone=demo_mutation:10m rate=30r/m;
limit_req_zone $http_x_demo_capability zone=demo_capability_read:10m rate=300r/m;
limit_req_zone $mutation_capability_key zone=demo_capability_mutation:10m rate=30r/m;
limit_conn_zone $request_client_key zone=demo_conn:10m;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 32k;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req_log_level warn;

    # 내부 프록시 헤더를 흉내 내거나 Worker와 공유 비밀이 어긋난 요청은
    # 원본 IP rate bucket으로 조용히 강등하지 않고 즉시 거부한다.
    if ($reject_untrusted_frontend_proxy) {
        return 403;
    }

    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_send_timeout 15s;
    proxy_read_timeout 15s;
    proxy_hide_header Server;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    # 실제 연결 원본이 신뢰 CIDR인 경우에만 ALB가 전달한 외부 scheme/port를 보존한다.
    proxy_set_header X-Forwarded-Port $trusted_forwarded_port;
    proxy_set_header X-Forwarded-Proto $trusted_forwarded_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Trace-Id $http_x_trace_id;
    # 프록시 인증·익명 rate key는 gateway 경계에서만 소비하고 Spring에는 노출하지 않는다.
    proxy_set_header X-Alzs-Proxy-Secret "";
    proxy_set_header X-Alzs-Client-Key "";

    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Retry-After $retry_after_seconds always;

    location = /actuator/health {
        access_log off;
        return 404;
    }

    location = /api/v1/system/readiness {
        access_log off;
        limit_req zone=demo_read burst=5 nodelay;
        limit_conn demo_conn 5;
        proxy_pass http://backend:8080;
    }

    location = /swagger-ui.html {
        proxy_pass http://backend:8080;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location /swagger-ui/ {
        proxy_pass http://backend:8080;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location = /api/v1/demo/sessions {
        limit_req zone=demo_session_create burst=3 nodelay;
        limit_conn demo_conn 10;
        proxy_pass http://backend:8080;
    }

    # q는 고객이 입력한 안전한 검색어지만 URI query에 포함되므로 원문을 access log에 남기지 않는다.
    location ~ ^/api/v1/customers/[^/]+/transactions/search$ {
        access_log off;
        limit_req zone=demo_read burst=80 nodelay;
        limit_conn demo_conn 20;
        proxy_pass http://backend:8080;
    }

    # 승인된 chunk bundle은 일반 업무 요청보다 크므로 관리자 단일 경로에만 제한적으로 허용한다.
    location = /api/v1/admin/knowledge/ingestion-imports {
        access_log off;
        client_max_body_size 4m;
        limit_req zone=demo_mutation burst=2 nodelay;
        limit_conn demo_conn 2;
        proxy_pass http://backend:8080;
    }

    location / {
        limit_req zone=demo_read burst=80 nodelay;
        limit_req zone=demo_mutation burst=10 nodelay;
        limit_req zone=demo_capability_read burst=80 nodelay;
        limit_req zone=demo_capability_mutation burst=10 nodelay;
        limit_conn demo_conn 20;
        proxy_pass http://backend:8080;
    }
}
